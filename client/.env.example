STRAPI_URL=http://127.0.0.1:1337
# STRAPI_API_TOKEN=  # read-only token из админки, когда закроем публичные права
# ImageKit URL endpoint (не секрет) — по нему CmsImage узнаёт картинки ImageKit и ресайзит их через ?tr=w-…,q-…
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- Administrace přihlášek (/sprava) ---
ADMIN_USER=gastrozony
# ADMIN_PASS=  # bez těchto dvou proměnných vrací /sprava 503

# --- Resend (potvrzovací e-maily přihlášek) ---
# RESEND_API_KEY=       # jen na serveru; bez klíče se e-maily neodesílají (mailSent zůstane false)
# MAIL_FROM="Gastrozóny <info@gastrozony.cz>"   # odesílatel musí být na ověřené doméně v Resendu
# MAIL_REPLY_TO=        # nepovinné; prázdné = e-mail z Global v administraci

# --- Ecomail (newsletter) ---
# ECOMAIL_API_KEY=      # jen na serveru; bez klíče se odběratel uloží jen do Strapi
# ECOMAIL_LIST_ID=      # použije se, když je pole v administraci (Newsletter) prázdné
# ECOMAIL_TAGS=web      # štítky oddělené čárkou; totéž — fallback k administraci
