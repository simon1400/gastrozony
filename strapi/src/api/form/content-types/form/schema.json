{
  "kind": "collectionType",
  "collectionName": "forms",
  "info": {
    "singularName": "form",
    "pluralName": "forms",
    "displayName": "Formulář",
    "description": "Dynamický formulář — pole se konfigurují zde, ne v kódu"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "key": {
      "type": "enumeration",
      "enum": [
        "prodejce",
        "poradatel"
      ],
      "required": true
    },
    "fields": {
      "type": "dynamiczone",
      "components": [
        "form.text-field",
        "form.select",
        "form.radio",
        "form.checkbox",
        "form.upload"
      ]
    },
    "consent": {
      "type": "component",
      "repeatable": false,
      "component": "form.checkbox"
    },
    "requiresEvent": {
      "type": "boolean",
      "default": false
    }
  }
}
