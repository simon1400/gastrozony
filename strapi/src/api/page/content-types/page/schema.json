{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Stránka",
    "description": "Obecná šablona — složí se z dynamických bloků"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "perex": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.text",
        "blocks.gallery",
        "blocks.cta",
        "blocks.cards",
        "blocks.tags",
        "blocks.logos",
        "blocks.stats",
        "blocks.image-text",
        "blocks.events",
        "blocks.accordion"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
